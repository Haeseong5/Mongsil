-- Emoticon 테이블 정의
CREATE TABLE EmoticonEntity (
    id INTEGER PRIMARY KEY NOT NULL,
    imageUrl TEXT NOT NULL,
    title TEXT NOT NULL,
    textColor TEXT NOT NULL,
    backgroundColor TEXT NOT NULL,
    lastUpdated INTEGER NOT NULL
);

-- 모든 이모티콘 조회
getAllEmoticons:
SELECT * FROM EmoticonEntity 
ORDER BY id ASC;

-- 특정 이모티콘 조회
getEmoticonById:
SELECT * FROM EmoticonEntity 
WHERE id = ?;

-- 이모티콘 저장 (UPSERT)
insertOrUpdateEmoticon:
INSERT OR REPLACE INTO EmoticonEntity (id, imageUrl, title, textColor, backgroundColor, lastUpdated)
VALUES (?, ?, ?, ?, ?, ?);

-- 모든 이모티콘 삭제
deleteAllEmoticons:
DELETE FROM EmoticonEntity;

-- 이모티콘 개수 조회
getEmoticonCount:
SELECT COUNT(*) FROM EmoticonEntity;

-- 마지막 업데이트 시간 조회
getLastUpdatedTime:
SELECT MAX(lastUpdated) FROM EmoticonEntity;
