CREATE TABLE CounterEntity (
    id INTEGER PRIMARY KEY NOT NULL,
    count INTEGER NOT NULL,
    lastUpdated INTEGER NOT NULL
);

getCounter:
SELECT * FROM CounterEntity WHERE id = 1;

insertOrUpdateCounter:
INSERT OR REPLACE INTO CounterEntity (id, count, lastUpdated)
VALUES (1, ?, ?);

deleteCounter:
DELETE FROM CounterEntity WHERE id = 1;
