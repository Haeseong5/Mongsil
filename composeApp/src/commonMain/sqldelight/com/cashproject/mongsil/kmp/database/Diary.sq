CREATE TABLE DiaryEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    year INTEGER NOT NULL,
    month INTEGER NOT NULL,
    day INTEGER NOT NULL,
    content TEXT NOT NULL,
    emoticonId INTEGER,
    photoUri TEXT,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

getDiaryByDate:
SELECT * FROM DiaryEntity
WHERE year = ? AND month = ? AND day = ?
ORDER BY updatedAt DESC
LIMIT 1;

getDiariesByYearMonth:
SELECT * FROM DiaryEntity
WHERE year = ? AND month = ?
ORDER BY day ASC;

getAllDiaries:
SELECT * FROM DiaryEntity
ORDER BY year DESC, month DESC, day DESC;

insertDiary:
INSERT INTO DiaryEntity (year, month, day, content, emoticonId, photoUri, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateDiary:
UPDATE DiaryEntity
SET content = ?, emoticonId = ?, photoUri = ?, updatedAt = ?
WHERE year = ? AND month = ? AND day = ?;

deleteDiary:
DELETE FROM DiaryEntity
WHERE year = ? AND month = ? AND day = ?;

hasDiaryForDate:
SELECT COUNT(*) > 0 FROM DiaryEntity
WHERE year = ? AND month = ? AND day = ?;
